    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- TELEMETRY DATA FLOW DETAIL BOX                                -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="flow-box" value="Telemetry Pipeline (End-to-End)&#xa;═══════════════════════════════&#xa;&#xa;1. User sends chat query&#xa;   ↓&#xa;2. oan_backend processes via FastGemini&#xa;   ↓&#xa;3. create_question_event() / create_error_event()&#xa;   builds TelemetryEvent (OE_ITEM_RESPONSE)&#xa;   ↓&#xa;4. asyncio.create_task(send_telemetry(...))&#xa;   fire-and-forget, non-blocking&#xa;   ↓&#xa;5. asyncpg INSERT → winston_logs (sync_status=0)&#xa;   TCP 5432 cross-account via public IP&#xa;   ↓&#xa;6. Processor polls every 5 min&#xa;   routes by field: questionsDetails → questions&#xa;                   errorDetails → errordetails&#xa;                   feedbackDetails → feedback&#xa;   sets sync_status=1&#xa;   ↓&#xa;7. MAHA Vistaar Insights Dashboard reads tables" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#F3E5F5;strokeColor=#7B1FA2;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
      <mxGeometry x="1380" y="900" width="340" height="340" as="geometry" />
    </mxCell>

