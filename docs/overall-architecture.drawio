    <!-- Cross-account label box -->
    <mxCell id="cross-label" value="CROSS-ACCOUNT TELEMETRY FLOW&#xa;─────────────────────────────&#xa;asyncpg INSERT into winston_logs&#xa;TCP 5432 over Public Internet&#xa;&#xa;Source: 98.90.156.237 (Playground EC2)&#xa;Dest:   13.232.206.114:5432 (Protean EC2)&#xa;Auth:   IP Whitelist in Security Group" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFEBEE;strokeColor=#CC0000;align=left;fontSize=9;fontFamily=Courier New;spacingLeft=8;fontColor=#CC0000;" vertex="1" parent="1">
